# ============================================
# VoltReserve Frontend Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# API Configuration
REACT_APP_API_URL=http://localhost:5000/api

# Map Configuration
REACT_APP_MAP_API_KEY=

# Feature Flags
REACT_APP_ENABLE_DEMO_MODE=true
REACT_APP_ENABLE_MAP=true
REACT_APP_ENABLE_ADMIN=true

# Default Configuration
REACT_APP_DEFAULT_ZOOM=13
REACT_APP_DEFAULT_LAT=28.6139
REACT_APP_DEFAULT_LNG=77.2090
REACT_APP_DEFAULT_RADIUS=2

# ============================================
# Production Settings (uncomment when deploying)
# ============================================

# REACT_APP_API_URL=https://api.voltreserve.com/api
# REACT_APP_ENABLE_DEMO_MODE=false