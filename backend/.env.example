# ============================================
# VoltReserve Backend Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_APP=app.py

# JWT Configuration
JWT_SECRET_KEY=your_super_secret_jwt_key_change_this_in_production_to_random_string

# Database Configuration
# Local MySQL
DATABASE_URL=mysql+mysqlconnector://root:password@localhost:3306/voltreserve

# Alternative: If using different credentials
# DATABASE_URL=mysql+mysqlconnector://voltreserve_app:your_secure_password_here@localhost:3306/voltreserve

# OpenChargeMap API (Get key from https://openchargemap.org/site/develop/api)
OPENCHARGEMAP_API_KEY=your_openchargemap_api_key_here

# VoltReserve Station Configuration
STATION_LAT=28.6139
STATION_LNG=77.2090
STATION_NAME=VoltReserve Station
RESERVATION_TIMEOUT_MINUTES=30
RESERVATION_RADIUS_KM=2

# ESP32 Configuration
ESP32_TIMEOUT_SECONDS=60

# Email Configuration (Optional - for notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_email_password

# Logging
LOG_LEVEL=DEBUG
LOG_FILE=voltreserve.log

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# ============================================
# Production Settings (uncomment when deploying)
# ============================================

# FLASK_ENV=production
# FLASK_DEBUG=False
# DATABASE_URL=mysql+mysqlconnector://voltreserve_app:your_secure_password@production_server:3306/voltreserve